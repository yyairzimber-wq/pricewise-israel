# --- Client (baked into the build) ---
# "demo" (bundled sample data) or "api" (real prices from the bundled server: npm run api → http://localhost:8787)
VITE_DATA_MODE=demo
VITE_API_BASE_URL=
# Vision endpoint. Leave empty to use the demo picker; "/api/recognize" when deployed on Vercel.
VITE_AI_ENDPOINT=

# --- Server only (never prefix with VITE_) ---
ANTHROPIC_API_KEY=
