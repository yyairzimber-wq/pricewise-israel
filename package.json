{
  "name": "pricewise-israel",
  "version": "0.1.0",
  "description": "PriceWise ישראל — השוואת מחירי מוצרי סופר בישראל",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "api": "node server/src/cli.ts serve",
    "ingest": "node server/src/cli.ts ingest",
    "geocode": "node server/src/cli.ts geocode",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json",
    "dev:phone": "vite --mode phone",
    "build:native": "vite build --mode native && cap sync",
    "android": "cap open android",
    "publish:vercel": "node server/src/cli.ts publish-vercel",
    "preview:vercel": "vite preview --outDir server/.vercel-deploy/pricewise-israel --port 5199 --strictPort"
  },
  "type": "module",
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@fontsource/heebo": "^5.3.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "basic-ftp": "^6.2.1",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  },
  "private": true
}
